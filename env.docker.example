# Docker Compose Environment Configuration
# Copy this to .env in the project root

# ============================================================================
# Event Store Configuration
# ============================================================================

# gRPC Server Port
GRPC_PORT=50051

# Backend type (postgres, memory)
BACKEND=postgres

# Logging level
RUST_LOG=info

# ============================================================================
# Gateway Configuration (ADR-024)
# ============================================================================
# eventstore-bin has no authentication of its own. The nginx `gateway`
# service is the only component in this compose file allowed to publish a
# port to the host, and it enforces Basic Auth on that port whenever
# ESP_GATEWAY_PASSWORD is set. Generate one with: openssl rand -hex 32
#
# Left BLANK on purpose (not a placeholder like "changeme...") - a shipped,
# repo-visible value here would defeat the whole point of the gateway if
# someone copies this file to .env without editing it. Blank = auth
# disabled with a loud startup warning (see docker-entrypoint.sh); only
# acceptable for fully local, non-exposed development, which is why
# ESP_GATEWAY_BIND below defaults to loopback.

ESP_GATEWAY_USER=admin
ESP_GATEWAY_PASSWORD=

# Host bind address for the gateway's published port. Loopback by default.
# Only set 0.0.0.0 (reachable from your network) together with a non-empty
# ESP_GATEWAY_PASSWORD above AND TLS: add `-f docker-compose.tls.yml`
# (#301). The gateway refuses to start plaintext on a non-loopback bind.
ESP_GATEWAY_BIND=127.0.0.1

# TLS cert dir for docker-compose.tls.yml (fullchain.pem + privkey.pem).
# Default: output of event-store/gateway/gen-self-signed.sh.
# ESP_GATEWAY_TLS_DIR=./event-store/gateway/tls

# ============================================================================
# Database Configuration
# ============================================================================

# Option 1: Use local PostgreSQL (with --profile local)
DATABASE_URL=postgres://eventstore:changeme@postgres:5432/eventstore
POSTGRES_DB=eventstore
POSTGRES_USER=eventstore
POSTGRES_PASSWORD=changeme-use-secure-password
POSTGRES_PORT=5432

# Option 2: Use external database (Supabase, RDS, etc.)
# DATABASE_URL=postgres://user:pass@db.supabase.co:5432/postgres

# Option 3: Use existing dev database
# DATABASE_URL=postgres://dev:dev@host.docker.internal:15342/dev

# ============================================================================
# Usage Examples
# ============================================================================

# Local with PostgreSQL:
#   docker-compose --profile local up

# With external database:
#   docker-compose up

# Build and run:
#   docker-compose up --build

# Run in background:
#   docker-compose up -d

# View logs:
#   docker-compose logs -f event-store

# Stop:
#   docker-compose down
