# Docker Compose Environment Configuration
# Copy this to .env in the project root

# ============================================================================
# Event Store Configuration
# ============================================================================

# gRPC Server Port
GRPC_PORT=50051

# Backend type (postgres, memory)
BACKEND=postgres

# Logging level
RUST_LOG=info

# ============================================================================
# Gateway Configuration (ADR-024)
# ============================================================================
# eventstore-bin has no authentication of its own. The nginx `gateway`
# service is the only component in this compose file allowed to publish a
# port to the host, and it requires Basic Auth on that port whenever
# ESP_GATEWAY_PASSWORD is set. Generate one with: openssl rand -hex 32
# Leave unset only for fully local, non-exposed development.

ESP_GATEWAY_USER=admin
ESP_GATEWAY_PASSWORD=changeme-generate-with-openssl-rand-hex-32

# ============================================================================
# Database Configuration
# ============================================================================

# Option 1: Use local PostgreSQL (with --profile local)
DATABASE_URL=postgres://eventstore:changeme@postgres:5432/eventstore
POSTGRES_DB=eventstore
POSTGRES_USER=eventstore
POSTGRES_PASSWORD=changeme-use-secure-password
POSTGRES_PORT=5432

# Option 2: Use external database (Supabase, RDS, etc.)
# DATABASE_URL=postgres://user:pass@db.supabase.co:5432/postgres

# Option 3: Use existing dev database
# DATABASE_URL=postgres://dev:dev@host.docker.internal:15342/dev

# ============================================================================
# Usage Examples
# ============================================================================

# Local with PostgreSQL:
#   docker-compose --profile local up

# With external database:
#   docker-compose up

# Build and run:
#   docker-compose up --build

# Run in background:
#   docker-compose up -d

# View logs:
#   docker-compose logs -f event-store

# Stop:
#   docker-compose down
