services:
  event-store:
    image: event-sourcing-platform-event-store:latest
    container_name: event-store
    # No host port published (ADR-024): eventstore-bin has no authn/authz of
    # its own. `gateway` is the only service in this stack allowed to
    # publish a port.
    env_file:
      - .env
    restart: unless-stopped
    # Overrides the image's baked-in HEALTHCHECK (hardcoded to port 50051 -
    # see event-store/Dockerfile) so a non-default eventstore_grpc_port
    # doesn't leave Docker permanently reporting this container unhealthy
    # even though it's actually fine on its configured port.
    healthcheck:
      test: ["CMD", "bash", "-c", "</dev/tcp/localhost/{{ eventstore_grpc_port }}"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    networks:
      - eventstore-network

  # nginx gateway: the event store's trust boundary. See ADR-024 and
  # event-store/gateway/README.md.
  gateway:
    image: event-sourcing-platform-gateway:latest
    container_name: event-store-gateway
    ports:
      - "{{ eventstore_grpc_port }}:8081"
    # Explicit environment, NOT `env_file: .env` (unlike event-store above):
    # .env also carries DATABASE_URL/POSTGRES_PASSWORD. Gateway is the one
    # network-facing container in this stack; a gateway compromise (e.g. an
    # nginx CVE) should not hand over direct database credentials it never
    # needed in the first place. `to_json` gives safe YAML/JSON string
    # escaping for values that may contain quotes, `$`, `#`, etc.
    environment:
      ESP_UPSTREAM: "event-store:{{ eventstore_grpc_port }}"
      # `$` must be doubled to `$$` BEFORE to_json: Compose interpolates
      # ${VAR}/$VAR across the ENTIRE compose file text (not just
      # env_file-loaded values) - a raw `$` here would still get expanded
      # by Compose itself even though to_json already made the value valid
      # YAML/JSON. Verified: `docker compose config` on an unescaped test
      # value expanded a literal "$HOME" to the render host's actual $HOME.
      ESP_GATEWAY_USER: {{ esp_gateway_user | replace('$', '$$') | to_json }}
      ESP_GATEWAY_PASSWORD: {{ esp_gateway_password | replace('$', '$$') | to_json }}
    restart: unless-stopped
    depends_on:
      - event-store
    networks:
      - eventstore-network

{% if use_local_postgres | default(false) %}
  postgres:
    image: postgres:16-alpine
    container_name: eventstore-postgres
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ postgres_password }}
      PGDATA: /var/lib/postgresql/data/pgdata
    ports:
      - "{{ postgres_port }}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    networks:
      - eventstore-network

volumes:
  postgres_data:
    driver: local
{% endif %}

networks:
  eventstore-network:
    driver: bridge
