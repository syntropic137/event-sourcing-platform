# Event Store Docker Compose Configuration
# Generated by Ansible

# Event Store Configuration
GRPC_PORT={{ eventstore_grpc_port }}
# eventstore-bin actually reads BIND_ADDR, not GRPC_PORT (see
# event-store/eventstore-bin/src/main.rs) - wire it explicitly so a
# non-default eventstore_grpc_port takes effect.
BIND_ADDR=0.0.0.0:{{ eventstore_grpc_port }}
BACKEND={{ eventstore_backend }}
RUST_LOG={{ eventstore_rust_log | default('info') }}

# Database Configuration
DATABASE_URL={{ eventstore_database_url }}

# Gateway credentials (ADR-024) are intentionally NOT in this file - the
# `gateway` service does not use env_file: .env (this file also carries
# DATABASE_URL/POSTGRES_PASSWORD, which the network-facing gateway
# container has no need to see). See ESP_* in docker-compose.yml.j2's
# `gateway.environment` block instead.

# PostgreSQL (only used with --profile local)
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_PORT={{ postgres_port }}
