# Event Store Docker Compose Configuration
# Generated by Ansible

# Event Store Configuration
GRPC_PORT={{ eventstore_grpc_port }}
BACKEND={{ eventstore_backend }}
RUST_LOG={{ eventstore_rust_log | default('info') }}

# Database Configuration
DATABASE_URL={{ eventstore_database_url }}

# Gateway Configuration (ADR-024) - eventstore-bin has no auth of its own;
# the `gateway` service enforces Basic Auth on the published port.
ESP_GATEWAY_USER={{ esp_gateway_user }}
ESP_GATEWAY_PASSWORD={{ esp_gateway_password }}

# PostgreSQL (only used with --profile local)
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_PORT={{ postgres_port }}
