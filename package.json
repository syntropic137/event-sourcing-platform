{
  "name": "event-sourcing-platform",
  "version": "0.12.0",
  "private": true,
  "workspaces": [
    "event-store/sdks/sdk-ts",
    "event-sourcing/typescript",
    "examples/*-ts",
    "vsa/vsa-visualizer"
  ],
  "scripts": {
    "build": "turbo run build --filter='!docs-site'",
    "build:all": "turbo run build",
    "build:docs": "turbo run build --filter=docs-site",
    "test": "turbo run test",
    "lint": "turbo run lint --continue || true",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean || true"
  },
  "devDependencies": {
    "turbo": "2.9.14"
  },
  "pnpm": {
    "overrides": {
      "follow-redirects": ">=1.16.0",
      "protobufjs": "7.6.5",
      "dompurify": "3.4.13",
      "@babel/core": "7.29.6",
      "@babel/plugin-transform-modules-systemjs": "7.29.4",
      "@grpc/grpc-js": "1.14.4",
      "@humanfs/node": "0.16.8",
      "@protobufjs/utf8": "1.1.1",
      "baseline-browser-mapping": "2.11.0",
      "body-parser": "1.20.6",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "browserslist": "4.28.7",
      "colord": "2.9.4",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.6",
      "http-proxy-middleware": "2.0.10",
      "joi": "17.13.6",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "launch-editor": "2.14.1",
      "mermaid": "11.16.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "postcss-selector-parser@6": "6.1.3",
      "postcss-selector-parser@7": "7.1.3",
      "qs": "6.16.0",
      "shell-quote": "1.9.0",
      "svgo": "3.3.5",
      "tmp": "0.2.7",
      "undici": "7.29.0",
      "uuid": "11.1.1",
      "webpack-dev-server": "5.2.6",
      "websocket-driver": "0.7.5",
      "ws@7": "7.5.11",
      "ws@8": "8.21.0"
    }
  },
  "packageManager": "pnpm@10.20.0"
}
